# Docker Compose 环境变量模板
# 使用：复制到仓库根目录并填写真实值
#   cp deploy/env.example .env
# 说明：.env 已被 .gitignore 忽略，禁止提交真实密钥。

# MySQL root 口令（仅容器内健康检查使用）
MYSQL_ROOT_PASSWORD=change-me-root

# 后端连接数据库的应用账号口令（容器启动时自动创建 tea_app 并授权 tea_guide）
MYSQL_APP_PASSWORD=change-me-app

# 会话签名密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-random-secret

# 管理员初始账号（种子由 database/init.sql 写入；上线后请用轮换脚本改密）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin

# 会话有效期（天）
SESSION_EXPIRE_DAYS=30

# 会话 Cookie 的 Secure 标记。
# 当前 compose 默认只提供 HTTP（http://<IP>:8080）：
#   - 纯 HTTP 演示必须设为 false，否则浏览器不会回传会话 Cookie（登录后立即 401）；
#   - 一旦在 web 前配置了 HTTPS 反向代理，必须改为 true。
COOKIE_SECURE=false

# 对外访问端口（Nginx）
WEB_PORT=8080
