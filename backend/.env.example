# 茶·图鉴 后端环境变量示例
# 复制为 .env 后按本地环境修改；.env 不进 Git（.gitignore 已覆盖）

# === 基础 ===
DEBUG=true

# === 数据库（MySQL 5.7.19） ===
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=tea_guide

# 测试库（可选）：pytest 默认使用 tea_guide_test；如需自定义连接串可设置该变量
# DATABASE_URL_TEST=mysql+pymysql://root:root@localhost:3306/tea_guide_test?charset=utf8mb4

# === 会话 ===
# 必填：未配置将拒绝启动。生成方式：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_EXPIRE_DAYS=30
# 会话 Cookie 的 Secure 标记；留空时由 DEBUG 推导（DEBUG=false → true）。
# 纯 HTTP 演示（非 localhost）必须显式设为 false，否则浏览器不会回传 Cookie。
# COOKIE_SECURE=false

# === 管理员初始账号 ===
# 生产部署必须通过环境变量注入，禁止使用内置默认密码；
# 轮换命令：python -m app.scripts.rotate_admin_password --password "新密码"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
